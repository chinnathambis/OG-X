//@version=6
// OG Breakout v2.0 — Original Predictum recreation (15 Oct 2026). Built from v1.0; v1.1–v1.5 (extra presets,
// timeframe scaling) are kept in archive/. Engine fixed on 45m like Predictum; Predictum-style statistics block.
// Engine: Donchian channel breakout on an engine timeframe (default 45m), intrabar touch entry,
// one position at a time, fixed % stop, fixed % take-profit ladder, same-side re-entry after a stop.
// Fitted on Binance USDT-M futures: reproduces a 50-signal BTC history exactly (see predictum/RESEARCH.md).
indicator("OG Breakout", "OG BRK", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────── Inputs
G_MAIN = "⚙ Engine"
presetIn = input.string("Auto (by chart coin)", "Strategy", options = ["Auto (by chart coin)", "Predictum BTC · 180 · 0.6% · 6%", "Predictum BTC · 210 · 0% · 6%", "Predictum ETH · 450 · 0% · 8%", "Custom"], group = G_MAIN,
     tooltip = "The original Predictum settings, recovered from its history. Auto picks BTC 180 on BTC charts and ETH 450 on ETH charts; any other coin uses Custom. BTC 180 = v2.2.x (45 min), BTC 210 = v.5 (matches its 50-signal history exactly), ETH 450 = ETH statistics.")
engTfIn  = input.timeframe("45", "Engine timeframe", group = G_MAIN, tooltip = "The channel is built on this timeframe. Use a chart timeframe equal to or lower than it (45m, 15m, 5m…).")
nU       = input.int(180, "Custom · channel length", minval = 10, maxval = 3000, group = G_MAIN)
bufU     = input.float(0.6, "Custom · entry buffer %", minval = 0.0, step = 0.1, group = G_MAIN, tooltip = "Long entry = channel high minus this %, short entry = channel low plus this %.")
slU      = input.float(6.0, "Custom · stop-loss %", minval = 0.1, step = 0.5, group = G_MAIN)

G_TGT = "🎯 Targets"
ladderIn = input.string("Classic 0.3/1/2/3/10", "Take-profit ladder", options = ["Classic 0.3/1/2/3/10", "Wide 1/2/3/4/8/20", "Custom"], group = G_TGT)
ladderU  = input.string("0.5, 1, 2, 4, 8", "Custom ladder % (comma separated)", group = G_TGT)
winTpIn  = input.int(2, "Count a win at TP #", minval = 1, maxval = 10, group = G_TGT, tooltip = "The 'accuracy' row counts trades that reached this TP before the stop.")
levIn    = input.float(10, "Leverage for % labels", minval = 1, group = G_TGT)
dcaOn    = input.bool(false, "Show averaging (DCA) levels", group = G_TGT)
dcaU     = input.string("7, 15, 25", "DCA distances %", group = G_TGT)

G_VIS = "🎨 Chart"
bgOn     = input.bool(true, "Highlight the background", group = G_VIS)
nextOn   = input.bool(true, "Show next entry levels", group = G_VIS)
tpslOn   = input.bool(true, "Show TP / SL lines", group = G_VIS)
tpLblOn  = input.bool(false, "Show take-profit labels", group = G_VIS)
entLblOn = input.bool(true, "Show entry price and time", group = G_VIS)
peakOn   = input.bool(true, "Show peak profit labels", group = G_VIS)
readyOn  = input.bool(true, "Show 'Get ready' labels", group = G_VIS)
readyPct = input.float(0.5, "Get ready distance %", minval = 0.05, step = 0.05, group = G_VIS)
colL     = input.color(#26a69a, "Long", inline = "c", group = G_VIS)
colS     = input.color(#ef5350, "Short", inline = "c", group = G_VIS)
colTP    = input.color(#8bc34a, "TP", inline = "c", group = G_VIS)
colSL    = input.color(#ff1744, "SL", inline = "c", group = G_VIS)

G_PNL = "📋 Statistics"
statsOn  = input.bool(true, "Show the statistics block", group = G_PNL)
statsN   = input.int(50, "The number of recent signals in statistics", minval = 5, maxval = 100, group = G_PNL)
realOn   = input.bool(false, "Also show realised results (exit at stop or next signal, 1×)", group = G_PNL, tooltip = "Not part of Predictum. Shows what holding each trade to its stop or the next signal would have returned.")
feeIn    = input.float(0.08, "Fees per trade % (realised row)", minval = 0, step = 0.01, group = G_PNL)
statsPos = input.string("Top R", "Position", options = ["Top R", "Bottom R", "Top L", "Bottom L"], group = G_PNL)
fromIn   = input.time(timestamp("2020-01-01T00:00:00"), "Count trades from", group = G_PNL)

// ─────────────────────────────── Preset resolution
string coinU = str.replace_all(str.replace_all(syminfo.ticker, ".P", ""), "PERP", "")
string presetEff = presetIn != "Auto (by chart coin)" ? presetIn : coinU == "BTCUSDT" ? "Predictum BTC · 180 · 0.6% · 6%" : coinU == "ETHUSDT" ? "Predictum ETH · 450 · 0% · 8%" : "Custom"
int N = switch presetEff
    "Predictum BTC · 180 · 0.6% · 6%" => 180
    "Predictum BTC · 210 · 0% · 6%"   => 210
    "Predictum ETH · 450 · 0% · 8%"   => 450
    => nU
float BUF = switch presetEff
    "Predictum BTC · 180 · 0.6% · 6%" => 0.006
    "Predictum BTC · 210 · 0% · 6%"   => 0.0
    "Predictum ETH · 450 · 0% · 8%"   => 0.0
    => bufU / 100
float SL = switch presetEff
    "Predictum BTC · 180 · 0.6% · 6%" => 0.06
    "Predictum BTC · 210 · 0% · 6%"   => 0.06
    "Predictum ETH · 450 · 0% · 8%"   => 0.08
    => slU / 100

string ladderStr = switch ladderIn
    "Classic 0.3/1/2/3/10" => "0.3,1,2,3,10"
    "Wide 1/2/3/4/8/20"    => "1,2,3,4,8,20"
    => ladderU

parsePct(string s) =>
    array<float> out = array.new<float>()
    for p in str.split(s, ",")
        float v = str.tonumber(str.replace_all(p, " ", ""))
        if not na(v) and v > 0
            out.push(v / 100)
    out.sort(order.ascending)
    out

var array<float> TPS = parsePct(ladderStr)
var array<float> DCA = parsePct(dcaU)
int nTP = TPS.size()

// ─────────────────────────────── Channel (no repaint: only closed engine bars are used)
string engTf = engTfIn == "" ? timeframe.period : engTfIn
bool   tfOK  = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(engTf)
[hhE, llE] = request.security(syminfo.tickerid, engTf, [ta.highest(high, N)[1], ta.lowest(low, N)[1]], lookahead = barmerge.lookahead_on)
float upL = hhE * (1 - BUF)
float dnL = llE * (1 + BUF)

// ─────────────────────────────── State
var int   pos    = 0      // 1 long, -1 short, 0 flat after a stop
var int   dir    = 0      // side of the last signal (background)
var float ent    = na
var int   entT   = na
var float pkPx   = na
var int   pkBar  = na
var bool  slHit  = false
var int   tpHit  = 0      // targets reached before the stop
var label pkLbl  = na
var array<line> curLines = array.new<line>()
var bool  armL = true
var bool  armS = true

// statistics (closed trades)
var array<int>   stT  = array.new<int>()
var array<int>   stD  = array.new<int>()
var array<float> stPk = array.new<float>()
var array<int>   stTp = array.new<int>()
var array<bool>  stSl = array.new<bool>()
var array<float> stR  = array.new<float>()

peakPct(int d, float e, float p) => d == 1 ? p / e - 1 : e / p - 1
// label rule (matches the original's history): a stopped trade whose best move never reached TP1 shows as -SL × leverage
shownPct(float pk, bool sl, int tp) =>
    float tp1 = nTP > 0 ? TPS.get(0) : 0.0
    sl and pk < tp1 ? -SL * levIn * 100 : pk * levIn * 100
fmtPct(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00") + "%"
fmtPx(float v) => str.tostring(v, format.mintick)
cleanSym() => str.replace_all(syminfo.ticker, ".P", "")
tpPrice(int d, float e, float p) => d == 1 ? e * (1 + p) : e / (1 + p)

// ─────────────────────────────── 1) Stop-loss on the open position (checked before a new signal)
bool slNow = false
if pos == 1 and low <= ent * (1 - SL)
    pos := 0
    slNow := true
else if pos == -1 and high >= ent * (1 + SL)
    pos := 0
    slNow := true

// ─────────────────────────────── 2) Signals: intrabar touch of the channel level
bool longSig  = tfOK and not na(upL) and high >= upL and pos != 1
bool shortSig = tfOK and not na(dnL) and low <= dnL and pos != -1 and not longSig
bool newSig   = longSig or shortSig

if newSig
    int   d  = longSig ? 1 : -1
    float px = longSig ? math.max(open, upL) : math.min(open, dnL)
    // close the previous trade (its peak excludes this bar)
    if dir != 0 and not na(ent)
        bool sl2 = slHit or slNow
        float r = sl2 ? -SL : (px / ent - 1) * dir
        if entT >= fromIn
            stT.push(entT)
            stD.push(dir)
            stPk.push(peakPct(dir, ent, pkPx))
            stTp.push(tpHit)
            stSl.push(sl2)
            stR.push(r)
        for l in curLines
            l.set_x2(bar_index)
        if peakOn and not na(pkLbl)
            pkLbl.set_text("Peak profit " + fmtPct(shownPct(peakPct(dir, ent, pkPx), sl2, tpHit)))
    curLines.clear()
    // open the new trade
    pos := d
    dir := d
    ent := px
    entT := time
    slHit := false
    tpHit := 0
    pkPx := d == 1 ? high : low
    pkBar := bar_index
    armL := true
    armS := true
    label.new(bar_index, d == 1 ? low : high, d == 1 ? "Long" : "Short", style = d == 1 ? label.style_label_up : label.style_label_down,
         color = d == 1 ? colL : colS, textcolor = color.white, size = size.small)
    if entLblOn
        label.new(bar_index, px, (d == 1 ? "LONG" : "SHORT") + " was opened at " + fmtPx(px) + "\nTime: " + str.format_time(time, "dd/MM/yyyy HH:mm", "UTC") + " UTC",
             style = label.style_label_right, color = color.new(d == 1 ? colL : colS, 15), textcolor = color.white, size = size.small)
    if tpslOn
        for p in TPS
            curLines.push(line.new(bar_index, tpPrice(d, px, p), bar_index + 1, tpPrice(d, px, p), color = colTP, style = line.style_dotted, width = 1))
        float slPx = d == 1 ? px * (1 - SL) : px * (1 + SL)
        curLines.push(line.new(bar_index, slPx, bar_index + 1, slPx, color = colSL, width = 2))
    if dcaOn
        for q in DCA
            float dp = d == 1 ? px * (1 - q) : px * (1 + q)
            curLines.push(line.new(bar_index, dp, bar_index + 1, dp, color = color.new(color.yellow, 20), style = line.style_dotted))
    if peakOn
        pkLbl := label.new(bar_index, pkPx, "", style = d == 1 ? label.style_label_down : label.style_label_up, color = color.new(#43a047, 0), textcolor = color.white, size = size.normal)
    // first bar's progress
    float fav0 = peakPct(d, px, pkPx)
    while tpHit < nTP and fav0 >= TPS.get(tpHit)
        tpHit += 1
    // alert with full trade plan
    string tpTxt = ""
    for [i, p] in TPS
        tpTxt += "\nTP " + str.tostring(i + 1) + ": " + fmtPx(tpPrice(d, px, p))
    alert("#" + cleanSym() + " | Open " + (d == 1 ? "Long" : "Short") + "\nEntry: " + fmtPx(px) + "\nTimeframe: " + engTf + tpTxt +
         "\nSL: " + fmtPx(d == 1 ? px * (1 - SL) : px * (1 + SL)), alert.freq_once_per_bar)
else if dir != 0 and not na(ent)
    // 3) track the open trade
    if not slHit
        float fav = peakPct(dir, ent, dir == 1 ? high : low)
        while tpHit < nTP and fav >= TPS.get(tpHit)
            tpHit += 1
            if tpLblOn
                label.new(bar_index, tpPrice(dir, ent, TPS.get(tpHit - 1)), "TP" + str.tostring(tpHit) + " ✓", style = label.style_label_left, color = color.new(colTP, 10), textcolor = color.white, size = size.tiny)
            alert("#" + cleanSym() + " | TP " + str.tostring(tpHit) + " reached", alert.freq_once_per_bar)
    if slNow
        slHit := true
        alert("#" + cleanSym() + " | Stop-loss hit", alert.freq_once_per_bar)
    bool newPk = dir == 1 ? high > pkPx : low < pkPx
    if newPk
        pkPx := dir == 1 ? high : low
        pkBar := bar_index
    for l in curLines
        l.set_x2(bar_index)

// peak label follows the best price
if peakOn and not na(pkLbl) and dir != 0 and not na(ent)
    pkLbl.set_xy(pkBar, pkPx)
    pkLbl.set_text("Peak profit " + fmtPct(shownPct(peakPct(dir, ent, pkPx), slHit, tpHit)))

// ─────────────────────────────── 4) Get ready (price near the next entry level)
if readyOn and tfOK and not newSig
    if pos != 1 and not na(upL) and armL and high >= upL * (1 - readyPct / 100)
        label.new(bar_index, high, "Get ready to Long", style = label.style_label_down, color = color.new(colL, 60), textcolor = color.white, size = size.tiny)
        alert("#" + cleanSym() + " | Get ready to Long · entry " + fmtPx(upL), alert.freq_once_per_bar)
        armL := false
    if pos != -1 and not na(dnL) and armS and low <= dnL * (1 + readyPct / 100)
        label.new(bar_index, low, "Get ready to Short", style = label.style_label_up, color = color.new(colS, 60), textcolor = color.white, size = size.tiny)
        alert("#" + cleanSym() + " | Get ready to Short · entry " + fmtPx(dnL), alert.freq_once_per_bar)
        armS := false
if not na(upL) and close < upL * (1 - 2 * readyPct / 100)
    armL := true
if not na(dnL) and close > dnL * (1 + 2 * readyPct / 100)
    armS := true

// ─────────────────────────────── Plots & alerts
bgcolor(bgOn and dir == 1 ? color.new(colL, 82) : bgOn and dir == -1 ? color.new(colS, 82) : na, title = "Trend background")
plot(nextOn and pos != 1 ? upL : na, "Next long entry", color.new(colL, 0), 1, plot.style_linebr)
plot(nextOn and pos != -1 ? dnL : na, "Next short entry", color.new(colS, 0), 1, plot.style_linebr)
alertcondition(longSig, "Long", "OG Breakout: LONG on {{ticker}} at {{close}}")
alertcondition(shortSig, "Short", "OG Breakout: SHORT on {{ticker}} at {{close}}")

// ─────────────────────────────── 5) Statistics block (Predictum style)
emo(float v) => v < 0 ? "🚫" : v < 10 ? "🤔" : v < 20 ? "😚" : v < 30 ? "😎" : v < 50 ? "🙌" : v < 200 ? "🔥" : "🎰"
var table tb = table.new(statsPos == "Top R" ? position.top_right : statsPos == "Bottom R" ? position.bottom_right : statsPos == "Top L" ? position.top_left : position.bottom_left,
     1, 115, bgcolor = color.new(#0d4a1e, 5), border_width = 0)
if barstate.islast
    tb.clear(0, 0, 0, 114)
    color tx = color.white
    if not tfOK
        tb.cell(0, 0, "⚠ Use a chart timeframe of " + engTf + " or lower", text_color = color.yellow, text_size = size.small)
    else if statsOn
        // newest first: open trade, then closed trades
        array<int>   lT = array.new<int>()
        array<int>   lD = array.new<int>()
        array<float> lP = array.new<float>()   // shown peak %, leveraged
        array<float> lW = array.new<float>()   // raw peak move
        array<float> lR = array.new<float>()   // realised, 1x, after fees
        if dir != 0 and not na(ent)
            lT.push(entT)
            lD.push(dir)
            lP.push(shownPct(peakPct(dir, ent, pkPx), slHit, tpHit))
            lW.push(peakPct(dir, ent, pkPx))
            lR.push((slHit ? -SL : (close / ent - 1) * dir) - feeIn / 100)
        int n = stT.size()
        for k = 0 to math.max(n - 1, 0)
            int i = n - 1 - k
            if n == 0 or lT.size() >= statsN
                break
            lT.push(stT.get(i))
            lD.push(stD.get(i))
            lP.push(shownPct(stPk.get(i), stSl.get(i), stTp.get(i)))
            lW.push(stPk.get(i))
            lR.push(stR.get(i) - feeIn / 100)
        int m = lT.size()
        tb.cell(0, 0, "┌──── Statistics on " + cleanSym() + " ────┐", text_color = tx, text_size = size.small)
        int row = 1
        float tot = 0.0
        int wins = 0
        int wins15 = 0
        float tp2 = nTP >= 2 ? TPS.get(1) : nTP == 1 ? TPS.get(0) : 0.01
        float eq = 1.0
        float peakEq = 1.0
        float maxDD = 0.0
        int realW = 0
        if m > 0
            for k = 0 to m - 1
                float v = lP.get(k)
                tb.cell(0, row, str.format_time(lT.get(k), "d.M.yy H:mm", "UTC") + " | " + (lD.get(k) == 1 ? "Long" : "Short") + " | " + str.tostring(v, "0.##") + "% " + emo(v),
                     text_color = tx, text_size = size.small)
                row += 1
                tot += v
                bool w = lW.get(k) >= tp2
                wins += w ? 1 : 0
                wins15 += (w and k < 15) ? 1 : 0
            // realised, oldest first
            for k = m - 1 to 0
                eq *= 1 + lR.get(k)
                peakEq := math.max(peakEq, eq)
                maxDD := math.max(maxDD, 1 - eq / peakEq)
                realW += lR.get(k) > 0 ? 1 : 0
            int n15 = math.min(15, m)
            float acc = 100.0 * wins / m
            float acc15 = 100.0 * wins15 / n15
            tb.cell(0, row, "──────────────────────", text_color = tx, text_size = size.small)
            row += 1
            tb.cell(0, row, "💵 TOTAL (max. profit): " + str.tostring(tot, "0.##") + "%", text_color = tx, text_size = size.small)
            row += 1
            tb.cell(0, row, "1️⃣ AVERAGE profit: " + str.tostring(tot / m, "0.##") + "%", text_color = tx, text_size = size.small)
            row += 1
            tb.cell(0, row, "👍 WINNING signals: " + str.tostring(wins) + "/" + str.tostring(m) + " (2 TP+ reached)", text_color = tx, text_size = size.small)
            row += 1
            tb.cell(0, row, "💎 ACCURACY (last " + str.tostring(m) + "): " + str.tostring(acc, "0") + "% (2 TP+) " + (acc >= 85 ? "📈 - very high accuracy" : acc >= 70 ? "📈 - high accuracy" : "📉 - low accuracy"), text_color = tx, text_size = size.small)
            row += 1
            tb.cell(0, row, "💎 ACCURACY (last " + str.tostring(n15) + "): " + str.tostring(acc15, "0") + "% " + (acc15 >= 85 ? "📈 - excellent dynamics" : acc15 >= 70 ? "📈 - good dynamics" : "📉 - weak dynamics"), text_color = tx, text_size = size.small)
            row += 1
            if realOn
                tb.cell(0, row, "Realised (stop or next signal, 1×, fees " + str.tostring(feeIn) + "%): wins " + str.tostring(100.0 * realW / m, "0") + "% · net " + fmtPct((eq - 1) * 100) + " · max DD " + str.tostring(maxDD * 100, "0.0") + "%",
                     text_color = color.yellow, text_size = size.small)
                row += 1
        tb.cell(0, row, "└────────────────────────┘", text_color = tx, text_size = size.small)
