//@version=6
// OG X v.2.4.0 + Alerts (16 Oct 2026)
// Engine (fixed on 45m): Donchian channel breakout, intrabar touch entry, one position at a time,
// fixed % stop (or the opposite signal), fixed % take-profit ladder, same-side re-entry after a stop.
// Strategy presets per coin, a "+" helper for the next entry, and a statistics block. Older versions in archive/.
indicator("OG X v.2.4.0 + Alerts", "OG X v.2.4.0 + Alerts", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────────── Strategy menu (shown in TradingView's legend)
const string O_AUTO = "Auto"
const string O_BTC  = "BTCUSDT.P - Binance Futures | 45 min timeframe"
const string O_BTC5 = "BTCUSDT.P - Binance Futures | 45 min timeframe | v.5"
const string O_ZEC  = "ZECUSDT.P - Binance Futures | 45 min timeframe"
const string O_DOGE = "DOGEUSDT.P - Binance Futures | 45 min timeframe"
const string O_QNT  = "QNTUSDT.P - Binance Futures | 45 min timeframe"
const string O_ETH  = "ETHUSDT.P - Binance Futures | 45 min timeframe"
const string O_PEPE = "1000PEPEUSDT.P - Binance Futures | 45 min timeframe"
const string O_XRP  = "XRPUSDT.P - Binance Futures | 45 min timeframe"
const string O_AAVE = "AAVEUSDT.P - Binance Futures | 45 min timeframe"
const string O_SOL  = "SOLUSDT.P - Binance Futures | 45 min timeframe"
const string O_PAXG = "PAXGUSDT.P - Binance Futures | 45 min timeframe"
const string O_SUI  = "SUIUSDT.P - Binance Futures | 45 min timeframe"
const string O_UNI  = "UNIUSDT.P - Binance Futures | 45 min timeframe"
const string O_ARB  = "ARBUSDT.P - Binance Futures | 45 min timeframe"
const string O_CUS  = "Custom"

const string TT_STRAT = "Original strategies (all on 45 min):\n" +
     "• BTC v2.2 = 180 bars / 0.6 % buffer / 6 % stop\n• BTC v.5 = 210 / 0 % / 6 %\n• ETH = 450 / 0 % / 8 %\n\n" +
     "Coin presets (Binance futures, Oct 2024 – Oct 2026, 1×, fees):\n" +
     "ZEC → v.5 · DOGE, QNT, ETH, XRP, AAVE → ETH · 1000PEPE, SOL → v.5 · PAXG → v2.2\n" +
     "⚠ SUI → ETH (weak in 2026) · ⚠ UNI → v2.2 (deep drawdown) · ⚠ ARB → v2.2 (flat in 2024–25)\n\n" +
     "Auto picks the preset for the chart's coin; other coins use Custom. With Auto the legend shows 'Auto': pick the coin's own entry to see its name there."
strategyIn = input.string(O_AUTO, "Strategy", options = [O_AUTO, O_BTC, O_BTC5, O_ZEC, O_DOGE, O_QNT, O_ETH, O_PEPE, O_XRP, O_AAVE, O_SOL, O_PAXG, O_SUI, O_UNI, O_ARB, O_CUS],
     tooltip = TT_STRAT, display = display.status_line)

G_GEN = "GENERAL SETTINGS"
bgOn     = input.bool(true,  "Highlight the background", group = G_GEN, inline = "bg", display = display.none)
bgStyle  = input.string("SL to edge", "", options = ["SL to edge", "Full height"], group = G_GEN, inline = "bg", display = display.none,
     tooltip = "SL to edge: the trade's shading starts at the stop line and runs to the profit side. Full height: the whole column is shaded. With 'Use the opposite signal as a Stop-Loss' there is no stop line, so the full height is used.")
entLblOn = input.bool(false, "Additional labels for position entry", group = G_GEN, display = display.none)
timeOn   = input.bool(false, "Show position opening time", group = G_GEN, display = display.none)
largeOn  = input.bool(true,  "Large Size of position entry/peak profit labels", group = G_GEN, display = display.none)
dcaOn    = input.bool(false, "Show averaging levels", group = G_GEN, display = display.none, tooltip = "Averaging (DCA) levels at 7 / 15 / 25 % against the entry, as used by DCA strategies. Display only: they are not used in the statistics.")
oppSlOn  = input.bool(false, "Use the opposite signal as a Stop-Loss", group = G_GEN, display = display.none, tooltip = "No fixed stop-loss: every position is held until the opposite signal.")

G_HLP = "HELPER SETTINGS"
helperOn = input.bool(true,  "Show Helper", group = G_HLP, display = display.none, tooltip = "A '+' at the next entry price (green = Long, red = Short) with a blue price tag, a price-scale marker, and 'Get ready to Long / Short' when price comes close.")
tagOn    = input.bool(true,  "Show next-signal tag on the current trade", group = G_HLP, display = display.none, tooltip = "While a trade is open: a blue tag next to the opposite '+' saying where the next signal fires and what happens to this trade (closes ±x % there, or your stop hits first). The % is the price move (1×). Off hides the tag only; the '+' and the price-scale marker stay.")
nextOn   = input.bool(false, "Show SL/TP of the next position", group = G_HLP, display = display.none)
curOn    = input.bool(true,  "Show SL/TP of the current position", group = G_HLP, display = display.none)
smallOn  = input.bool(false, "Text size: small", group = G_HLP, display = display.none)
lightOn  = input.bool(false, "Light theme", group = G_HLP, display = display.none)

G_ST = "STATISTICS"
statsOn  = input.bool(true, "Show the statistics block", group = G_ST, display = display.none)
statsBg  = input.color(#0d4a1e, "Statistics background", group = G_ST, display = display.none)
statsN   = input.int(50, "The number of recent signals in statistics", minval = 5, maxval = 100, group = G_ST, display = display.none)
statsPos = input.string("Top R", "Statistics position", options = ["Top R", "Bottom R", "Top L", "Bottom L"], group = G_ST, display = display.none)

G_CUS = "CUSTOM STRATEGY (other coins)"
nU       = input.int(180, "Channel length (45m bars)", minval = 10, maxval = 3000, group = G_CUS, display = display.none)
bufU     = input.float(0.6, "Entry buffer %", minval = 0.0, step = 0.1, group = G_CUS, display = display.none)
slU      = input.float(6.0, "Stop-loss %", minval = 0.1, step = 0.5, group = G_CUS, display = display.none)
ladderU  = input.string("0.3, 1, 2, 3, 10", "Take-profits % (comma separated)", group = G_CUS, display = display.none)

G_EXT = "EXTRA"
levIn    = input.float(10, "Leverage for % labels", minval = 1, group = G_EXT, display = display.none)
realOn   = input.bool(false, "Show realised results (exit at stop or next signal, 1×)", group = G_EXT, display = display.none)
feeIn    = input.float(0.08, "Fees per trade % (realised results)", minval = 0, step = 0.01, group = G_EXT, display = display.none)

// ─────────────────────────────── Strategy resolution
string ENG_TF    = "45"      // engine timeframe
float  READY_PCT = 0.5       // Helper: 'Get ready' distance %
string coinU = str.replace_all(str.replace_all(syminfo.ticker, ".P", ""), "PERP", "")
string autoPick = switch coinU
    "BTCUSDT"      => O_BTC
    "ETHUSDT"      => O_ETH
    "ZECUSDT"      => O_ZEC
    "DOGEUSDT"     => O_DOGE
    "QNTUSDT"      => O_QNT
    "1000PEPEUSDT" => O_PEPE
    "XRPUSDT"      => O_XRP
    "AAVEUSDT"     => O_AAVE
    "SOLUSDT"      => O_SOL
    "PAXGUSDT"     => O_PAXG
    "SUIUSDT"      => O_SUI
    "UNIUSDT"      => O_UNI
    "ARBUSDT"      => O_ARB
    => O_CUS
string stratEff = strategyIn == O_AUTO ? autoPick : strategyIn
// which original strategy sits behind each menu entry
string kind = switch stratEff
    O_BTC  => "v22"
    O_PAXG => "v22"
    O_UNI  => "v22"
    O_ARB  => "v22"
    O_BTC5 => "v5"
    O_ZEC  => "v5"
    O_PEPE => "v5"
    O_SOL  => "v5"
    O_ETH  => "eth"
    O_DOGE => "eth"
    O_QNT  => "eth"
    O_XRP  => "eth"
    O_AAVE => "eth"
    O_SUI  => "eth"
    => "custom"
// a preset picked by hand for another coin: warn (e.g. the UNI preset on a 1000PEPE chart)
string presetCoin = kind == "custom" ? "" : str.split(stratEff, ".P")[0]
string mismatchNote = presetCoin != "" and presetCoin != coinU ? "⚠ Preset is for " + presetCoin + ".P, chart is " + coinU + ".P" : ""
string weakNote = stratEff == O_SUI ? "⚠ SUI preset: weak in 2026 (+1 %)" : stratEff == O_UNI ? "⚠ UNI preset: deep drawdown (66 %)" : stratEff == O_ARB ? "⚠ ARB preset: flat in 2024–25 (+1 %)" : ""
int N = switch kind
    "v22" => 180
    "v5"  => 210
    "eth" => 450
    => nU
float BUF = switch kind
    "v22" => 0.006
    "v5"  => 0.0
    "eth" => 0.0
    => bufU / 100
float SL = switch kind
    "v22" => 0.06
    "v5"  => 0.06
    "eth" => 0.08
    => slU / 100
string ladderStr = kind == "custom" ? ladderU : "0.3,1,2,3,10"

parsePct(string s) =>
    array<float> out = array.new<float>()
    for p in str.split(s, ",")
        float v = str.tonumber(str.replace_all(p, " ", ""))
        if not na(v) and v > 0
            out.push(v / 100)
    out.sort(order.ascending)
    out

var array<float> TPS = parsePct(ladderStr)
var array<float> DCA = array.from(0.07, 0.15, 0.25)
int nTP = TPS.size()

// ─────────────────────────────── Theme & sizes
color colL  = #26a69a
color colS  = #ef5350
color colTP = #4caf50
color colSL = #ff1744
color colHl = #2962ff
// trade background: deeper, more transparent tints on the dark theme so candles stay readable
color bxL   = lightOn ? color.new(#5e9fa3, 55) : color.new(#26a69a, 85)
color bxS   = lightOn ? color.new(#f48fb1, 55) : color.new(#f23645, 80)
bool  xBg   = bgOn and bgStyle == "SL to edge" and not oppSlOn
color txCol = lightOn ? #131722 : color.white
string szS  = smallOn ? size.tiny : size.small
string szL  = largeOn ? (smallOn ? size.normal : size.large) : (smallOn ? size.small : size.normal)
string szT  = szL   // one size for every tag (entry, peak, blue tags, Get ready, next-position labels); only Long/Short use szS

// ─────────────────────────────── Channel (no repaint: only closed 45m bars are used)
bool tfOK = timeframe.in_seconds(timeframe.period) <= timeframe.in_seconds(ENG_TF)
[hhE, llE] = request.security(syminfo.tickerid, ENG_TF, [ta.highest(high, N)[1], ta.lowest(low, N)[1]], lookahead = barmerge.lookahead_on)
float upL = hhE * (1 - BUF)
float dnL = llE * (1 + BUF)

// ─────────────────────────────── State
var int   pos    = 0      // 1 long, -1 short, 0 flat after a stop
var int   dir    = 0      // side of the last signal (background)
var float ent    = na
var int   entT   = na
var float pkPx   = na
var int   pkBar  = na
var bool  slHit  = false
var int   tpHit  = 0      // targets reached before the stop
var label pkLbl  = na
var box   trBox  = na     // background of the current trade (stop to profit side)
var array<line> curLines = array.new<line>()
var bool  armL = true
var bool  armS = true

// statistics (closed trades)
var array<int>   stT  = array.new<int>()
var array<int>   stD  = array.new<int>()
var array<float> stPk = array.new<float>()
var array<int>   stTp = array.new<int>()
var array<bool>  stSl = array.new<bool>()
var array<float> stR  = array.new<float>()

peakPct(int d, float e, float p) => d == 1 ? p / e - 1 : e / p - 1
// label rule (matches the original's history): a stopped trade whose best move never reached TP1 shows as -SL × leverage
shownPct(float pk, bool sl, int tp) =>
    float tp1 = nTP > 0 ? TPS.get(0) : 0.0
    sl and pk < tp1 ? -SL * levIn * 100 : pk * levIn * 100
fmtPct(float v) => (v >= 0 ? "+" : "") + str.tostring(v, "0.00") + "%"
fmtPx(float v) => str.tostring(v, format.mintick)
cleanSym() => str.replace_all(syminfo.ticker, ".P", "")
tpPrice(int d, float e, float p) => d == 1 ? e * (1 + p) : e / (1 + p)
slPrice(int d, float e) => d == 1 ? e * (1 - SL) : e * (1 + SL)
// far edge of the X background: past the best price and the last take-profit, plus a margin
// (capped instead of running to infinity, so the box never squashes the price scale)
xFar(int d, float e, float pk) =>
    float s0 = slPrice(d, e)
    float lastTp = nTP > 0 ? tpPrice(d, e, TPS.get(nTP - 1)) : e
    float f = d == 1 ? math.max(pk, lastTp) : math.min(pk, lastTp)
    f + (f - s0) * 0.25

// ─────────────────────────────── 1) Stop-loss on the open position (checked before a new signal)
bool slNow = false
if not oppSlOn
    if pos == 1 and low <= ent * (1 - SL)
        pos := 0
        slNow := true
    else if pos == -1 and high >= ent * (1 + SL)
        pos := 0
        slNow := true

// ─────────────────────────────── 2) Signals: intrabar touch of the channel level
bool longSig  = tfOK and not na(upL) and high >= upL and pos != 1
bool shortSig = tfOK and not na(dnL) and low <= dnL and pos != -1 and not longSig
bool newSig   = longSig or shortSig

if newSig
    int   d  = longSig ? 1 : -1
    float px = longSig ? math.max(open, upL) : math.min(open, dnL)
    // close the previous trade (its peak excludes this bar)
    if dir != 0 and not na(ent)
        bool sl2 = slHit or slNow
        float r = sl2 ? -SL : (px / ent - 1) * dir
        stT.push(entT)
        stD.push(dir)
        stPk.push(peakPct(dir, ent, pkPx))
        stTp.push(tpHit)
        stSl.push(sl2)
        stR.push(r)
        if not slHit
            for l in curLines
                l.set_x2(bar_index)
        if not na(trBox) and not slHit
            trBox.set_right(bar_index)
        if not na(pkLbl)
            pkLbl.set_text("Peak profit " + fmtPct(shownPct(peakPct(dir, ent, pkPx), sl2, tpHit)))
    curLines.clear()
    // open the new trade
    pos := d
    dir := d
    ent := px
    entT := time
    slHit := false
    tpHit := 0
    pkPx := d == 1 ? high : low
    pkBar := bar_index
    trBox := na
    if xBg
        float s0 = slPrice(d, px)
        float f0 = xFar(d, px, pkPx)
        trBox := box.new(bar_index, d == 1 ? f0 : s0, bar_index + 1, d == 1 ? s0 : f0, border_color = color(na), border_width = 0, bgcolor = d == 1 ? bxL : bxS)
    armL := true
    armS := true
    label.new(bar_index, d == 1 ? low : high, d == 1 ? "Long" : "Short", style = d == 1 ? label.style_label_up : label.style_label_down,
         color = d == 1 ? colL : colS, textcolor = color.white, size = szS)
    if entLblOn or timeOn
        string txt = (entLblOn ? (d == 1 ? "LONG" : "SHORT") + " was opened at " + fmtPx(px) : "") + (entLblOn and timeOn ? "\n" : "") +
             (timeOn ? "Time: " + str.format_time(time, "d/M/yyyy HH:mm", "UTC") + " UTC" : "")
        label.new(bar_index, px, txt, style = label.style_label_right, color = color.new(d == 1 ? colL : colS, 15), textcolor = color.white, size = szT)
    if curOn
        for p in TPS
            curLines.push(line.new(bar_index, tpPrice(d, px, p), bar_index + 1, tpPrice(d, px, p), color = colTP, width = 2))
        if not oppSlOn
            curLines.push(line.new(bar_index, slPrice(d, px), bar_index + 1, slPrice(d, px), color = colSL, width = 2))
    if dcaOn
        for q in DCA
            float dp = d == 1 ? px * (1 - q) : px * (1 + q)
            curLines.push(line.new(bar_index, dp, bar_index + 1, dp, color = color.new(color.yellow, 20), style = line.style_dotted))
    pkLbl := label.new(bar_index, pkPx, "", style = d == 1 ? label.style_label_down : label.style_label_up, color = color.new(#43a047, 0), textcolor = color.white, size = szT)
    // first bar's progress (targets can already be reached on the entry candle)
    float fav0 = peakPct(d, px, pkPx)
    while tpHit < nTP and fav0 >= TPS.get(tpHit)
        tpHit += 1
        alert("#" + cleanSym() + " | TP " + str.tostring(tpHit) + " reached", alert.freq_once_per_bar)
    // alert with full trade plan
    string tpTxt = ""
    for [i, p] in TPS
        tpTxt += "\nTP " + str.tostring(i + 1) + ": " + fmtPx(tpPrice(d, px, p))
    alert("#" + cleanSym() + " | Open " + (d == 1 ? "Long" : "Short") + "\nEntry: " + fmtPx(px) + "\nTimeframe: 45 min" + tpTxt +
         (oppSlOn ? "\nSL: opposite signal" : "\nSL: " + fmtPx(slPrice(d, px))), alert.freq_once_per_bar)
else if dir != 0 and not na(ent)
    // 3) track the open trade
    if not slHit
        float fav = peakPct(dir, ent, dir == 1 ? high : low)
        while tpHit < nTP and fav >= TPS.get(tpHit)
            tpHit += 1
            alert("#" + cleanSym() + " | TP " + str.tostring(tpHit) + " reached", alert.freq_once_per_bar)
    bool wasOpen = not slHit
    if slNow
        slHit := true
        alert("#" + cleanSym() + " | Stop-loss hit", alert.freq_once_per_bar)
    bool newPk = dir == 1 ? high > pkPx : low < pkPx
    if newPk
        pkPx := dir == 1 ? high : low
        pkBar := bar_index
    // lines and background run from the entry candle to the exit candle (stop or next signal)
    if wasOpen
        for l in curLines
            l.set_x2(bar_index)
    if not na(trBox) and wasOpen
        trBox.set_right(bar_index)
        if newPk and not slHit
            float f1 = xFar(dir, ent, pkPx)
            if dir == 1
                trBox.set_top(f1)
            else
                trBox.set_bottom(f1)

// peak label follows the best price
if not na(pkLbl) and dir != 0 and not na(ent)
    pkLbl.set_xy(pkBar, pkPx)
    pkLbl.set_text("Peak profit " + fmtPct(shownPct(peakPct(dir, ent, pkPx), slHit, tpHit)))

// ─────────────────────────────── 4) Helper: 'Get ready' pill (blue, triangle)
if helperOn and tfOK and not newSig
    if pos != 1 and not na(upL) and armL and high >= upL * (1 - READY_PCT / 100)
        label.new(bar_index, low, "▲ Get ready", style = label.style_label_up, color = colHl, textcolor = color.white, size = szT)
        alert("#" + cleanSym() + " | Get ready to Long · entry " + fmtPx(upL), alert.freq_once_per_bar)
        armL := false
    if pos != -1 and not na(dnL) and armS and low <= dnL * (1 + READY_PCT / 100)
        label.new(bar_index, high, "▼ Get ready", style = label.style_label_down, color = colHl, textcolor = color.white, size = szT)
        alert("#" + cleanSym() + " | Get ready to Short · entry " + fmtPx(dnL), alert.freq_once_per_bar)
        armS := false
if not na(upL) and close < upL * (1 - 2 * READY_PCT / 100)
    armL := true
if not na(dnL) and close > dnL * (1 + 2 * READY_PCT / 100)
    armS := true

// which next entries are shown: during a trade only the opposite one; with no open trade only the closer one
bool flat   = pos == 0
bool nearL  = not na(upL) and not na(dnL) ? (upL / close - 1) <= (1 - dnL / close) : not na(upL)
bool showL  = helperOn and tfOK and not na(upL) and (pos == -1 or (flat and nearL))
bool showS  = helperOn and tfOK and not na(dnL) and (pos == 1 or (flat and not nearL))
float atrV  = ta.atr(14)

// "+" at the next entry, blue tag, next-position SL/TP (all redrawn on the last bar only)
var array<label> nxtLbls  = array.new<label>()
var array<line>  nxtLines = array.new<line>()
int PLUS_X = 6   // bars to the right of the live candle (centre of the "+")
int PLUS_W = 4   // half width of the "+" in bars
// d = side of the next signal, e = its price
drawNext(int d, float e) =>
    color sc = d == 1 ? colL : colS
    // big "+" drawn from two thick lines so it is visible at any zoom
    float hh = nz(atrV, e * 0.003) * 1.6
    nxtLines.push(line.new(bar_index + PLUS_X - PLUS_W, e, bar_index + PLUS_X + PLUS_W, e, color = sc, width = 4))
    nxtLines.push(line.new(bar_index + PLUS_X, e - hh, bar_index + PLUS_X, e + hh, color = sc, width = 4))
    string nm = d == 1 ? "Long" : "Short"
    string txt = ""
    if pos == -d and not na(ent)
        // an open trade that this signal would close
        if tagOn
            int cur = -d
            float pnl = (e / ent - 1) * cur * 100
            bool inside = oppSlOn or (cur == 1 ? e > slPrice(cur, ent) : e < slPrice(cur, ent))
            string cn = cur == 1 ? "Long" : "Short"
            txt := "Next " + nm + " at " + fmtPx(e) + "\n" + (inside ? "this " + cn + " closes " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "0.0") + "% there" :
                 "your stop (−" + str.tostring(SL * 100, "0.#") + "%) hits first")
    else
        // no open trade: entry price and distance from the current price
        float dist = (e / close - 1) * 100
        txt := "Next " + nm + " at " + fmtPx(e) + "\n" + (dist >= 0 ? "+" : "") + str.tostring(dist, "0.0") + "% from price"
    if txt != ""
        nxtLbls.push(label.new(bar_index + PLUS_X + PLUS_W + 2, e, txt, style = label.style_label_left, color = colHl, textcolor = color.white,
             size = szT, textalign = text.align_left, text_font_family = font.family_monospace))
    if nextOn
        int x2 = bar_index + 24
        nxtLines.push(line.new(bar_index, e, x2, e, color = sc, width = 2))
        nxtLbls.push(label.new(x2, e, nm + " entry", style = label.style_label_left, color = sc, textcolor = color.white, size = szT))
        if not oppSlOn
            nxtLines.push(line.new(bar_index, slPrice(d, e), x2, slPrice(d, e), color = colSL, width = 2))
            nxtLbls.push(label.new(x2, slPrice(d, e), "Stop-loss", style = label.style_label_left, color = colSL, textcolor = color.white, size = szT))
        for [i, p] in TPS
            nxtLines.push(line.new(bar_index, tpPrice(d, e, p), x2, tpPrice(d, e, p), color = colTP, width = 2))
            nxtLbls.push(label.new(x2, tpPrice(d, e, p), "Take-profit #" + str.tostring(i + 1), style = label.style_label_left, color = colTP, textcolor = color.white, size = szT))
if barstate.islast
    for l in nxtLbls
        l.delete()
    for l in nxtLines
        l.delete()
    nxtLbls.clear()
    nxtLines.clear()
    if showL
        drawNext(1, upL)
    if showS
        drawNext(-1, dnL)

// price-scale values (shown by TradingView's "Indicators and financials → name and value labels" scale setting)
plot(showL ? upL : na, "Next Long", color = colL, display = display.price_scale, editable = false)
plot(showS ? dnL : na, "Next Short", color = colS, display = display.price_scale, editable = false)
bool tradeOpen = dir != 0 and not na(ent) and not slHit
tpAt(int k) =>
    float v = na
    if tradeOpen and nTP > k
        v := tpPrice(dir, ent, TPS.get(k))
    v
plot(tpAt(0), "TP1", color = colTP, display = display.price_scale, editable = false)
plot(tpAt(1), "TP2", color = colTP, display = display.price_scale, editable = false)
plot(tpAt(2), "TP3", color = colTP, display = display.price_scale, editable = false)
plot(tpAt(3), "TP4", color = colTP, display = display.price_scale, editable = false)
plot(tpAt(4), "TP5", color = colTP, display = display.price_scale, editable = false)
plot(tradeOpen and not oppSlOn ? slPrice(dir, ent) : na, "SL", color = colSL, display = display.price_scale, editable = false)

// ─────────────────────────────── Background & alerts
bool fullBg = bgOn and not xBg
bgcolor(fullBg and dir == 1 ? color.new(colL, lightOn ? 88 : 80) : fullBg and dir == -1 ? color.new(colS, lightOn ? 88 : 80) : na, title = "Background")
alertcondition(longSig, "Long", "OG X: LONG on {{ticker}} at {{close}}")
alertcondition(shortSig, "Short", "OG X: SHORT on {{ticker}} at {{close}}")

// ─────────────────────────────── 5) Warning. The header is TradingView's legend: indicator name + Strategy input.
var table wn = table.new(position.middle_center, 1, 4, bgcolor = color.new(#d32f2f, 10))
if barstate.islast
    wn.clear(0, 0, 0, 3)
    if not tfOK
        wn.cell(0, 0, "WARNING!\nYour chart is configured incorrectly.", text_color = color.white, text_size = size.normal)
        wn.cell(0, 1, "HOW TO SET IT UP CORRECTLY?", text_color = color.white, text_size = size.normal)
        wn.cell(0, 2, "✅ Set the timeframe to 45 minutes (or lower).", text_color = color.white, text_size = size.normal)
        wn.cell(0, 3, strategyIn == O_AUTO and stratEff == O_CUS ? "ℹ No preset for this coin: Custom settings are used." : "", text_color = color.white, text_size = size.small)

// ─────────────────────────────── 6) Statistics block
emo(float v) => v < 0 ? "🚫" : v < 10 ? "🤔" : v < 20 ? "😚" : v < 30 ? "😎" : v < 50 ? "🙌" : v < 200 ? "🔥" : "🎰"
var table tb = table.new(statsPos == "Top R" ? position.top_right : statsPos == "Bottom R" ? position.bottom_right : statsPos == "Top L" ? position.top_left : position.bottom_left,
     1, 117, bgcolor = lightOn ? color.new(#c8e6c9, 0) : statsBg, border_width = 0)
if barstate.islast
    tb.clear(0, 0, 0, 116)
    if statsOn and tfOK
        // newest first: open trade, then closed trades
        array<int>   lT = array.new<int>()
        array<int>   lD = array.new<int>()
        array<float> lP = array.new<float>()   // shown peak %, leveraged
        array<float> lW = array.new<float>()   // raw peak move
        array<float> lR = array.new<float>()   // realised, 1x, after fees
        if dir != 0 and not na(ent)
            lT.push(entT)
            lD.push(dir)
            lP.push(shownPct(peakPct(dir, ent, pkPx), slHit, tpHit))
            lW.push(peakPct(dir, ent, pkPx))
            lR.push((slHit ? -SL : (close / ent - 1) * dir) - feeIn / 100)
        int n = stT.size()
        for k = 0 to math.max(n - 1, 0)
            int i = n - 1 - k
            if n == 0 or lT.size() >= statsN
                break
            lT.push(stT.get(i))
            lD.push(stD.get(i))
            lP.push(shownPct(stPk.get(i), stSl.get(i), stTp.get(i)))
            lW.push(stPk.get(i))
            lR.push(stR.get(i) - feeIn / 100)
        int m = lT.size()
        tb.cell(0, 0, "┌──── Statistics on " + cleanSym() + " ────┐", text_color = txCol, text_size = szS)
        int row = 1
        if mismatchNote != ""
            tb.cell(0, row, mismatchNote, text_color = lightOn ? #b71c1c : color.yellow, text_size = szS)
            row += 1
        if weakNote != ""
            tb.cell(0, row, weakNote, text_color = lightOn ? #b71c1c : color.yellow, text_size = szS)
            row += 1
        float tot = 0.0
        int wins = 0
        int wins15 = 0
        float tp2 = nTP >= 2 ? TPS.get(1) : nTP == 1 ? TPS.get(0) : 0.01
        float eq = 1.0
        float peakEq = 1.0
        float maxDD = 0.0
        int realW = 0
        if m > 0
            for k = 0 to m - 1
                float v = lP.get(k)
                tb.cell(0, row, str.format_time(lT.get(k), "d.M.yy H:mm", "UTC") + " | " + (lD.get(k) == 1 ? "Long" : "Short") + " | " + str.tostring(v, "0.##") + "% " + emo(v),
                     text_color = txCol, text_size = szS)
                row += 1
                tot += v
                bool w = lW.get(k) >= tp2
                wins += w ? 1 : 0
                wins15 += (w and k < 15) ? 1 : 0
            // realised, oldest first
            for k = m - 1 to 0
                eq *= 1 + lR.get(k)
                peakEq := math.max(peakEq, eq)
                maxDD := math.max(maxDD, 1 - eq / peakEq)
                realW += lR.get(k) > 0 ? 1 : 0
            int n15 = math.min(15, m)
            float acc = 100.0 * wins / m
            float acc15 = 100.0 * wins15 / n15
            tb.cell(0, row, "────────────────────", text_color = txCol, text_size = szS)
            row += 1
            tb.cell(0, row, "💵 TOTAL (max. profit): " + str.tostring(tot, "0.##") + "%", text_color = txCol, text_size = szS)
            row += 1
            tb.cell(0, row, "1️⃣ AVERAGE profit: " + str.tostring(tot / m, "0.##") + "%", text_color = txCol, text_size = szS)
            row += 1
            tb.cell(0, row, "👍 WINNING signals: " + str.tostring(wins) + "/" + str.tostring(m) + " (2 TP+)", text_color = txCol, text_size = szS)
            row += 1
            tb.cell(0, row, "💎 ACCURACY last " + str.tostring(m) + ": " + str.tostring(acc, "0") + "% " + (acc >= 85 ? "📈 very high" : acc >= 70 ? "📈 high" : "📉 low"), text_color = txCol, text_size = szS)
            row += 1
            tb.cell(0, row, "💎 ACCURACY last " + str.tostring(n15) + ": " + str.tostring(acc15, "0") + "% " + (acc15 >= 85 ? "📈 excellent" : acc15 >= 70 ? "📈 good" : "📉 weak"), text_color = txCol, text_size = szS)
            row += 1
            if realOn
                tb.cell(0, row, "Realised (stop or next signal, 1×, fees " + str.tostring(feeIn) + "%):\nwins " + str.tostring(100.0 * realW / m, "0") + "% · net " + fmtPct((eq - 1) * 100) + " · max DD " + str.tostring(maxDD * 100, "0.0") + "%",
                     text_color = lightOn ? #b71c1c : color.yellow, text_size = szS)
                row += 1
        tb.cell(0, row, "└──────────────────┘", text_color = txCol, text_size = szS)
