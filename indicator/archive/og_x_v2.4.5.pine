//@version=6
// OG X v.2.4.5 + Alerts (17 Oct 2026)
// Engine (fixed on 45m): Donchian channel breakout, intrabar touch entry, one position at a time,
// fixed % stop (or the opposite signal), fixed % take-profit ladder, same-side re-entry after a stop.
// Strategy presets per coin, a "+" helper for the next entry, and a statistics block. Older versions in archive/.
indicator("OG X v.2.4.5 + Alerts", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─────────────────────────────── Strategy menu (shown in TradingView's legend): BTC entries first, then A–Z
const string O_AUTO = "Auto"
const string O_BTC  = "BTCUSDT.P - Binance Futures | 45 min timeframe"
const string O_BTC5 = "BTCUSDT.P - Binance Futures | 45 min timeframe | v.5"
const string O_B1000BONK = "1000BONKUSDT.P - Binance Futures | 45 min timeframe"
const string O_B1000PEPE = "1000PEPEUSDT.P - Binance Futures | 45 min timeframe"
const string O_AAVE     = "AAVEUSDT.P - Binance Futures | 45 min timeframe"
const string O_AERO     = "AEROUSDT.P - Binance Futures | 45 min timeframe"
const string O_AR       = "ARUSDT.P - Binance Futures | 45 min timeframe"
const string O_ARB      = "ARBUSDT.P - Binance Futures | 45 min timeframe"
const string O_BCH      = "BCHUSDT.P - Binance Futures | 45 min timeframe"
const string O_BLUR     = "BLURUSDT.P - Binance Futures | 45 min timeframe"
const string O_BOME     = "BOMEUSDT.P - Binance Futures | 45 min timeframe"
const string O_DASH     = "DASHUSDT.P - Binance Futures | 45 min timeframe"
const string O_DOGE     = "DOGEUSDT.P - Binance Futures | 45 min timeframe"
const string O_EGLD     = "EGLDUSDT.P - Binance Futures | 45 min timeframe"
const string O_ENJ      = "ENJUSDT.P - Binance Futures | 45 min timeframe"
const string O_ETH      = "ETHUSDT.P - Binance Futures | 45 min timeframe"
const string O_GALA     = "GALAUSDT.P - Binance Futures | 45 min timeframe"
const string O_GRT      = "GRTUSDT.P - Binance Futures | 45 min timeframe"
const string O_KAIA     = "KAIAUSDT.P - Binance Futures | 45 min timeframe"
const string O_KMNO     = "KMNOUSDT.P - Binance Futures | 45 min timeframe"
const string O_MINA     = "MINAUSDT.P - Binance Futures | 45 min timeframe"
const string O_PAXG     = "PAXGUSDT.P - Binance Futures | 45 min timeframe"
const string O_PENGU    = "PENGUUSDT.P - Binance Futures | 45 min timeframe"
const string O_POL      = "POLUSDT.P - Binance Futures | 45 min timeframe"
const string O_QNT      = "QNTUSDT.P - Binance Futures | 45 min timeframe"
const string O_RAYSOL   = "RAYSOLUSDT.P - Binance Futures | 45 min timeframe"
const string O_RENDER   = "RENDERUSDT.P - Binance Futures | 45 min timeframe"
const string O_S        = "SUSDT.P - Binance Futures | 45 min timeframe"
const string O_SAND     = "SANDUSDT.P - Binance Futures | 45 min timeframe"
const string O_SEI      = "SEIUSDT.P - Binance Futures | 45 min timeframe"
const string O_SOL      = "SOLUSDT.P - Binance Futures | 45 min timeframe"
const string O_STRK     = "STRKUSDT.P - Binance Futures | 45 min timeframe"
const string O_SUI      = "SUIUSDT.P - Binance Futures | 45 min timeframe"
const string O_TAO      = "TAOUSDT.P - Binance Futures | 45 min timeframe"
const string O_TRX      = "TRXUSDT.P - Binance Futures | 45 min timeframe"
const string O_UNI      = "UNIUSDT.P - Binance Futures | 45 min timeframe"
const string O_VVV      = "VVVUSDT.P - Binance Futures | 45 min timeframe"
const string O_WLD      = "WLDUSDT.P - Binance Futures | 45 min timeframe"
const string O_XLM      = "XLMUSDT.P - Binance Futures | 45 min timeframe"
const string O_XRP      = "XRPUSDT.P - Binance Futures | 45 min timeframe"
const string O_ZEC      = "ZECUSDT.P - Binance Futures | 45 min timeframe"
const string O_BASK = "Basket (any coin) · 20 days · 12 % stop"
const string O_CUS  = "Custom"

const string TT_STRAT = "Original strategies (all on 45 min):\n" +
     "• BTC v2.2 = 180 bars / 0.6 % buffer / 6 % stop\n• BTC v.5 = 210 / 0 % / 6 %\n• ETH = 450 / 0 % / 8 %\nTuned coins use their own bars / buffer / stop.\n\n" +
     "Rating (our backtest, Binance futures, Oct 2024 – Oct 2026, 1×, fees):\n" +
     "🏆 TOP PICK ★★★: PENGU, MINA, DASH, 1000BONK, AERO, SEI, S, STRK, WLD, ARB, UNI\n" +
     "✅ SOLID ★★: ZEC, DOGE, ETH, 1000PEPE, SOL, SUI, TAO, RAYSOL, BOME, BLUR, POL, KMNO, GRT, ENJ, GALA, RENDER, XLM, KAIA, SAND\n" +
     "⚠ CAUTION ★: QNT, XRP, AAVE, PAXG, EGLD, BCH, VVV, AR, TRX, BTC v2.2, BTC v.5\n\n" +
     "Ratings are from a backtest that used the same period to choose the presets (in-sample). Past results do not predict the next trade.\n\n" +
     "Basket (any coin): 640 bars (20 days) / 0 % / 12 % stop with the trend filter. Tested as a portfolio of 96 coins: +44 % over 2 years, max drawdown 18.5 %.\n\n" +
     "Auto picks the preset for the chart's coin; other coins use Basket. With Auto the legend shows 'Auto': pick the coin's own entry to see its name there."
strategyIn = input.string(O_AUTO, "Strategy", options = [O_AUTO, O_BTC, O_BTC5, O_B1000BONK, O_B1000PEPE, O_AAVE, O_AERO, O_AR, O_ARB, O_BCH, O_BLUR, O_BOME, O_DASH, O_DOGE, O_EGLD, O_ENJ, O_ETH, O_GALA, O_GRT, O_KAIA, O_KMNO, O_MINA, O_PAXG, O_PENGU, O_POL, O_QNT, O_RAYSOL, O_RENDER, O_S, O_SAND, O_SEI, O_SOL, O_STRK, O_SUI, O_TAO, O_TRX, O_UNI, O_VVV, O_WLD, O_XLM, O_XRP, O_ZEC, O_BASK, O_CUS],
     tooltip = TT_STRAT, display = display.status_line)
G_GEN = "GENERAL SETTINGS"
bgOn     = input.bool(true,  "Highlight the background", group = G_GEN, inline = "bg", display = display.none)
bgStyle  = input.string("SL to edge", "", options = ["SL to edge", "Full height"], group = G_GEN, inline = "bg", display = display.none,
     tooltip = "SL to edge: the trade's shading starts at the stop line and runs to the profit side. Full height: the whole column is shaded. With 'Use the opposite signal as a Stop-Loss' there is no stop line, so the full height is used.")
entLblOn = input.bool(false, "Additional labels for position entry", group = G_GEN, display = display.none)
timeOn   = input.bool(false, "Show position opening time", group = G_GEN, display = display.none)
largeOn  = input.bool(true,  "Large Size of position entry/peak profit labels", group = G_GEN, display = display.none)
dcaOn    = input.bool(false, "Show averaging levels", group = G_GEN, display = display.none, tooltip = "Averaging (DCA) levels at 7 / 15 / 25 % against the entry, as used by DCA strategies. Display only: they are not used in the statistics.")
chkOff   = input.bool(false, "Hide the chart check", group = G_GEN, display = display.none, tooltip = "Hides the red WARNING box (wrong timeframe, exchange or ticker type) and the blue 'No preset' note with the supported-tickers list.")
oppSlOn  = input.bool(false, "Use the opposite signal as a Stop-Loss", group = G_GEN, display = display.none, tooltip = "No fixed stop-loss: every position is held until the opposite signal.")

G_HLP = "HELPER SETTINGS"
helperOn = input.bool(true,  "Show Helper", group = G_HLP, display = display.none, tooltip = "A '+' at the next entry price (green = Long, red = Short) with a blue price tag, a price-scale marker, and 'Get ready to Long / Short' when price comes close.")
tagOn    = input.bool(true,  "Show next-signal tag on the current trade", group = G_HLP, display = display.none, tooltip = "While a trade is open: a blue tag next to the opposite '+' saying where the next signal fires and what happens to this trade (closes ±x % there, or your stop hits first). The % is the price move (1×). Off hides the tag only; the '+' and the price-scale marker stay.")
nextOn   = input.bool(false, "Show SL/TP of the next position", group = G_HLP, display = display.none)
curOn    = input.bool(true,  "Show SL/TP of the current position", group = G_HLP, display = display.none)
smallOn  = input.bool(false, "Text size: small", group = G_HLP, display = display.none)
lightOn  = input.bool(false, "Light theme", group = G_HLP, display = display.none)

G_ST = "STATISTICS"
statsOn  = input.bool(true, "Show the statistics block", group = G_ST, display = display.none)
statsBg  = input.color(#0d4a1e, "Statistics background", group = G_ST, display = display.none)
statsN   = input.int(50, "The number of recent signals in statistics", minval = 5, maxval = 100, group = G_ST, display = display.none)
statsSz  = input.string("Normal", "Statistics text size", options = ["Small", "Normal", "Large"], group = G_ST, display = display.none)
statsPos = input.string("Top R", "Statistics position", options = ["Top R", "Bottom R", "Top L", "Bottom L"], group = G_ST, display = display.none)

statsRate = input.string("backtest, in-sample", "Rating label", options = ["backtest, in-sample", "Hide rating"], group = G_ST, display = display.none)

G_FLT = "FILTERS"
trendMode = input.string("Auto", "Trend filter (coin + BTC, 15-day EMA)", options = ["Auto", "On", "Off"], group = G_FLT, display = display.none,
     tooltip = "Longs only when the coin and BTC both close above their 15-day EMA (480 × 45m bars); Shorts only when both are below. A skipped signal still closes an open opposite trade. Auto = on for Basket and Custom, off for coin presets.")

G_TPP = "TAKE-PROFIT PLAN"
tpPlan = input.string("Hold (stop or next signal)", "TP plan", options = ["Hold (stop or next signal)", "50 % at +8 %, rest holds", "Ladder (equal parts at each TP)"], group = G_TPP, display = display.none,
     tooltip = "How the realised results are counted. Hold: the whole position exits at the stop or the next signal. 50 % at +8 %: half is taken at +8 % (green line), the rest holds. Ladder: equal parts at each take-profit.")

G_SZ = "POSITION SIZE"
sizeOn  = input.bool(true, "Show suggested size in the statistics", group = G_SZ, display = display.none)
halfWin = input.bool(true, "Half size after a win above +10 %", group = G_SZ, display = display.none)
riskPct = input.float(1.0, "Risk per trade %", minval = 0.1, step = 0.1, group = G_SZ, display = display.none,
     tooltip = "Share of your capital you lose if the stop is hit. Suggested size = risk ÷ stop distance, adjusted for the coin's current volatility (0.5–2×) and halved after a win above +10 %.")

G_CUS = "CUSTOM STRATEGY (other coins)"
nU       = input.int(180, "Channel length (45m bars)", minval = 10, maxval = 3000, group = G_CUS, display = display.none)
bufU     = input.float(0.6, "Entry buffer %", minval = 0.0, step = 0.1, group = G_CUS, display = display.none)
slU      = input.float(6.0, "Stop-loss %", minval = 0.1, step = 0.5, group = G_CUS, display = display.none)
ladderU  = input.string("0.3, 1, 2, 3, 10", "Take-profits % (comma separated)", group = G_CUS, display = display.none)

G_EXT = "EXTRA"
levIn    = input.float(10, "Leverage for % labels", minval = 1, group = G_EXT, display = display.none)
realOn   = input.bool(false, "Show realised results (exit at stop or next signal, 1×)", group = G_EXT, display = display.none)
feeIn    = input.float(0.08, "Fees per trade % (realised results)", minval = 0, step = 0.01, group = G_EXT, display = display.none)

// ─────────────────────────────── Strategy resolution
string ENG_TF    = "45"      // engine timeframe
float  READY_PCT = 0.5       // Helper: 'Get ready' distance %
string coinU = str.replace_all(str.replace_all(syminfo.ticker, ".P", ""), "PERP", "")
string coinK = str.endswith(coinU, "USDT") ? str.substring(coinU, 0, str.length(coinU) - 4) : coinU

// Preset settings, fixed width: "bars buffer% stop%"
prm(string k) =>
    switch k
        "BTC" => "180 0.6 06"
        "BTC5" => "210 0.0 06"
        "1000BONK" => "450 0.0 08"
        "1000PEPE" => "210 0.0 06"
        "AAVE" => "450 0.0 08"
        "AERO" => "450 0.0 08"
        "AR" => "680 0.0 10"
        "ARB" => "060 0.6 10"
        "BCH" => "210 0.0 06"
        "BLUR" => "210 0.0 06"
        "BOME" => "450 0.0 08"
        "DASH" => "450 0.0 08"
        "DOGE" => "450 0.0 08"
        "EGLD" => "680 1.0 10"
        "ENJ" => "450 0.0 08"
        "ETH" => "450 0.0 08"
        "GALA" => "450 0.0 08"
        "GRT" => "180 0.6 06"
        "KAIA" => "700 0.0 03"
        "KMNO" => "210 0.0 06"
        "MINA" => "180 0.6 06"
        "PAXG" => "180 0.6 06"
        "PENGU" => "450 0.0 08"
        "POL" => "180 0.6 06"
        "QNT" => "450 0.0 08"
        "RAYSOL" => "210 0.0 06"
        "RENDER" => "450 0.0 08"
        "S" => "060 0.6 10"
        "SAND" => "660 1.0 08"
        "SEI" => "180 0.6 06"
        "SOL" => "210 0.0 06"
        "STRK" => "170 1.0 08"
        "SUI" => "700 1.0 04"
        "TAO" => "060 0.0 10"
        "TRX" => "700 0.6 03"
        "UNI" => "070 0.6 08"
        "VVV" => "450 0.0 08"
        "WLD" => "060 0.0 04"
        "XLM" => "180 0.0 04"
        "XRP" => "450 0.0 08"
        "ZEC" => "210 0.0 06"
        => ""

// Backtest rating: "tier|2024–25 %|2026 %|max DD %|profit factor|caution reason"
