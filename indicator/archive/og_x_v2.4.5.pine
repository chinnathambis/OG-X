    switch k
        "BTC" => "1|-28|-28|58|0.8|Lost money in both periods · keep size small"
        "BTC5" => "1|-37|21|42|1.0|Lost money in 2024–25 · keep size small"
        "1000BONK" => "3|264|63|35|2.5|"
        "1000PEPE" => "2|79|18|48|1.4|"
        "AAVE" => "1|90|6|48|1.7|Weak in 2026 (+6%)"
        "AERO" => "3|88|154|36|2.9|"
        "AR" => "1|38|113|27|2.7|Only 8 trades in 2026"
        "ARB" => "3|574|104|42|1.6|"
        "BCH" => "1|-74|93|78|0.9|Lost money in 2024–25 · keep size small"
        "BLUR" => "2|120|11|40|1.5|"
        "BOME" => "2|28|105|43|1.8|"
        "DASH" => "3|122|186|41|3.1|"
